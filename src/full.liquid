{%- comment -%} ===== School timetable: shared data prep ===== {%- endcomment -%}
{%- capture nl %}
{% endcapture -%}
{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
{%- assign class_name = cf.class_name | default: "" | strip -%}
{%- assign school_year = cf.school_year | default: "" | strip -%}

{%- assign hl = true -%}
{%- if cf.highlight_today == false or cf.highlight_today == "false" -%}{%- assign hl = false -%}{%- endif -%}
{%- assign show_room = true -%}
{%- if cf.show_room == false or cf.show_room == "false" -%}{%- assign show_room = false -%}{%- endif -%}

{%- comment -%} grid orientation: days across the top (default), or days down the side and time across the top {%- endcomment -%}
{%- assign orient = cf.orientation | default: "" | downcase -%}
{%- assign days_as_rows = false -%}
{%- if orient contains "row" -%}{%- assign days_as_rows = true -%}{%- endif -%}

{%- assign times_arr = cf.lesson_times | default: "" | split: nl -%}
{%- assign breaks_arr = cf.breaks | default: "" | split: nl -%}
{%- assign mon_arr = cf.mon | default: "" | split: nl -%}
{%- assign tue_arr = cf.tue | default: "" | split: nl -%}
{%- assign wed_arr = cf.wed | default: "" | split: nl -%}
{%- assign thu_arr = cf.thu | default: "" | split: nl -%}
{%- assign fri_arr = cf.fri | default: "" | split: nl -%}

{%- comment -%} user's local time {%- endcomment -%}
{%- assign now_utc = trmnl.system.timestamp_utc | default: "now" | date: "%s" | plus: 0 -%}
{%- assign offset = trmnl.user.utc_offset | default: 0 | plus: 0 -%}
{%- assign now_local = now_utc | plus: offset -%}
{%- assign dow = now_local | date: "%u" | plus: 0 -%}
{%- assign now_h = now_local | date: "%H" | plus: 0 -%}
{%- assign now_m = now_local | date: "%M" | plus: 0 -%}
{%- assign now_min = now_h | times: 60 | plus: now_m -%}
{%- assign today_str = now_local | date: "%d.%m" -%}

{%- assign is_weekend = false -%}
{%- if dow > 5 -%}{%- assign is_weekend = true -%}{%- endif -%}
{%- assign show_dow = dow -%}
{%- if is_weekend -%}{%- assign show_dow = 1 -%}{%- endif -%}
{%- assign next_dow = dow | plus: 1 -%}
{%- if next_dow > 5 -%}{%- assign next_dow = 1 -%}{%- endif -%}

{%- comment -%} title-bar icon: a weekday grid with one column filled.
     Generated by tools/make_icon.py — do not edit by hand. {%- endcomment -%}
{%- assign tt_icon = "data:image/svg+xml;base64," -%}

{%- assign day_keys = "mon,tue,wed,thu,fri" | split: "," -%}
{%- assign day_short = "Mon,Tue,Wed,Thu,Fri" | split: "," -%}
{%- assign day_long = "Monday,Tuesday,Wednesday,Thursday,Friday" | split: "," -%}

{%- comment -%}
  after-school activities: one per line, "Mon | 15:00-16:30 | Football".
  Stored per day as "time|name~time|name" ("~" separates entries).
{%- endcomment -%}
{%- assign acts_arr = cf.activities | default: "" | split: nl -%}
{%- assign mon_acts = "" -%}
{%- assign tue_acts = "" -%}
{%- assign wed_acts = "" -%}
{%- assign thu_acts = "" -%}
{%- assign fri_acts = "" -%}
{%- assign has_acts = false -%}
{%- for a in acts_arr -%}
  {%- assign line = a | strip -%}
  {%- if line == "" -%}{%- continue -%}{%- endif -%}
  {%- assign parts = line | split: "|" -%}
  {%- assign a_day = parts[0] | default: "" | strip | downcase | slice: 0, 3 -%}
  {%- assign a_time = "" -%}
  {%- assign a_name = "" -%}
  {%- if parts.size > 2 -%}
    {%- assign a_time = parts[1] | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" | replace: "-", "–" -%}
    {%- assign a_name = parts[2] | strip -%}
  {%- elsif parts.size == 2 -%}
    {%- assign a_name = parts[1] | strip -%}
  {%- endif -%}
  {%- if a_name == "" -%}{%- continue -%}{%- endif -%}
  {%- assign entry = a_time | append: "|" | append: a_name -%}
  {%- case a_day -%}
    {%- when "mon" -%}
      {%- if mon_acts != "" -%}{%- assign mon_acts = mon_acts | append: "~" -%}{%- endif -%}
      {%- assign mon_acts = mon_acts | append: entry -%}
    {%- when "tue" -%}
      {%- if tue_acts != "" -%}{%- assign tue_acts = tue_acts | append: "~" -%}{%- endif -%}
      {%- assign tue_acts = tue_acts | append: entry -%}
    {%- when "wed" -%}
      {%- if wed_acts != "" -%}{%- assign wed_acts = wed_acts | append: "~" -%}{%- endif -%}
      {%- assign wed_acts = wed_acts | append: entry -%}
    {%- when "thu" -%}
      {%- if thu_acts != "" -%}{%- assign thu_acts = thu_acts | append: "~" -%}{%- endif -%}
      {%- assign thu_acts = thu_acts | append: entry -%}
    {%- when "fri" -%}
      {%- if fri_acts != "" -%}{%- assign fri_acts = fri_acts | append: "~" -%}{%- endif -%}
      {%- assign fri_acts = fri_acts | append: entry -%}
    {%- else -%}
      {%- continue -%}
  {%- endcase -%}
  {%- assign has_acts = true -%}
{%- endfor -%}

{%- comment -%} how many lesson rows are actually filled in (max 8) {%- endcomment -%}
{%- assign n_rows = 0 -%}
{%- for i in (0..7) -%}
  {%- assign any = "" -%}
  {%- assign any = any | append: mon_arr[i] | append: tue_arr[i] | append: wed_arr[i] | append: thu_arr[i] | append: fri_arr[i] -%}
  {%- assign any = any | replace: "-", "" | strip -%}
  {%- if any != "" -%}{%- assign n_rows = i | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if n_rows == 0 -%}{%- assign n_rows = times_arr.size -%}{%- endif -%}
{%- if n_rows > 8 -%}{%- assign n_rows = 8 -%}{%- endif -%}
{%- assign last_i = n_rows | minus: 1 -%}

{%- comment -%} index of the lesson happening right now (0-based), or -1 {%- endcomment -%}
{%- assign now_i = -1 -%}
{%- if hl and is_weekend == false -%}
  {%- for i in (0..last_i) -%}
    {%- assign t = times_arr[i] | default: "" | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" -%}
    {%- assign t_start = t | split: "-" | first | default: "" -%}
    {%- assign t_end = t | split: "-" | last | default: "" -%}
    {%- if t_start contains ":" and t_end contains ":" -%}
      {%- assign hh = t_start | split: ":" | first | plus: 0 -%}
      {%- assign mm = t_start | split: ":" | last | plus: 0 -%}
      {%- assign s_min = hh | times: 60 | plus: mm -%}
      {%- assign hh = t_end | split: ":" | first | plus: 0 -%}
      {%- assign mm = t_end | split: ":" | last | plus: 0 -%}
      {%- assign e_min = hh | times: 60 | plus: mm -%}
      {%- if now_min >= s_min and now_min < e_min -%}{%- assign now_i = i -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
<style>
  {%- comment -%}
    Only the few properties the Framework has no utility class for. Anything
    the recipe guidelines list as unnecessary is done with Framework classes
    on the elements instead.
  {%- endcomment -%}
  .tt-grid { table-layout: fixed; }
  .tt-grid th, .tt-grid td { vertical-align: middle; overflow: hidden; }
  .tt-nw { white-space: nowrap; }
  /* Deliberate: brackets today between two solid rules, which stays legible
     on 1-bit e-ink where a tint or a hairline would not. inset box-shadow
     rather than a border so it does not add to the cell's size. Vertical
     pair when days are columns, horizontal pair when they are rows. */
  .tt-today { box-shadow: inset 2px 0 0 #000, inset -2px 0 0 #000; }
  .tt-today-row { box-shadow: inset 0 2px 0 #000, inset 0 -2px 0 #000; }
  /* the activities block is divided off along whichever edge faces the lessons */
  .tt-act-sep { border-top: 2px solid #000; }
  .tt-act-row td { border-top: 2px solid #000; }
</style>

{%- comment -%} ===== FULL: the whole week ===== {%- endcomment -%}

{%- comment -%}
  Fill the screen: stretch the grid instead of letting the rows hug their
  content, which left it sitting in a band with dead space above and below.

  tt_fill is the one knob. It is a percentage of .layout, which the framework
  sizes to screen - gaps - title bar; 100 overflowed on a real device, most
  likely because that rule depends on :has() and the renderer falls back to a
  height that still includes the title bar. Under 100 covers the difference.

  Do not swap this for vh: that measures the whole viewport, title bar and
  gaps included, so it overshoots badly and data-table-limit responds by
  silently dropping rows.
{%- endcomment -%}
{%- assign tt_fill = 88 -%}
{%- comment -%}
  Column count when days run down the side: one per lesson, plus one for the
  activities column when there is anything to put in it. has_acts is only true
  once a line has actually parsed into a day, so an empty or unparseable
  activities field adds no column. The day name takes the remaining 13%.
{%- endcomment -%}
{%- if days_as_rows -%}
  {%- assign n_cols = n_rows -%}
  {%- if has_acts -%}{%- assign n_cols = n_cols | plus: 1 -%}{%- endif -%}
  {%- assign colw = 87 | divided_by: n_cols -%}
{%- endif -%}
<style>
  {%- comment -%} table-layout is fixed, so the header row sets every column {%- endcomment -%}
  {%- if days_as_rows -%}
  .tt-week thead th:first-child { width: 13%; }
  .tt-week thead th:not(:first-child) { width: {{ colw }}%; }
  {%- else -%}
  .tt-week thead th:nth-child(1) { width: 6%; }
  .tt-week thead th:nth-child(2) { width: 13%; }
  .tt-week thead th:nth-child(n+3) { width: 16%; }
  {%- endif -%}
</style>

<div class="layout layout--col layout--stretch-x gap--small">
{%- if days_as_rows -%}

  {%- comment -%} --- time across the top, days down the side --- {%- endcomment -%}
  <table class="table table--base lg:table--large tt-grid tt-week w--full h--[{{ tt_fill }}cqh]" data-table-limit="true">
    <thead>
      <tr>
        <th class="text--center py--1 px--1"><span class="title title--small lg:title--base block">Day</span></th>
        {%- for i in (0..last_i) -%}
          {%- assign lesson_no = forloop.index -%}
          {%- assign t = times_arr[i] | default: "" | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" | replace: "-", "–" -%}
          <th class="text--center py--1 px--1">
            {%- if i == now_i -%}
              <span class="label label--inverted lg:label--large block">{{ lesson_no }}</span>
              <span class="label label--small text--bold tt-nw block">{{ t }}</span>
            {%- else -%}
              <span class="title title--small lg:title--base block">{{ lesson_no }}</span>
              <span class="label label--small text--gray-30 tt-nw block">{{ t }}</span>
            {%- endif -%}
          </th>
        {%- endfor -%}
        {%- if has_acts -%}
          <th class="border--v-black text--center py--1 px--1">
            <span class="title title--small lg:title--base block">After school</span>
            <span class="label label--small text--gray-30 block">&nbsp;</span>
          </th>
        {%- endif -%}
      </tr>
    </thead>
    <tbody>
    {%- for dk in day_keys -%}
      {%- assign d_no = forloop.index -%}
      {%- assign d_i = forloop.index0 -%}
      {%- case dk -%}
        {%- when "mon" -%}{%- assign arr = mon_arr -%}{%- assign acts = mon_acts -%}
        {%- when "tue" -%}{%- assign arr = tue_arr -%}{%- assign acts = tue_acts -%}
        {%- when "wed" -%}{%- assign arr = wed_arr -%}{%- assign acts = wed_acts -%}
        {%- when "thu" -%}{%- assign arr = thu_arr -%}{%- assign acts = thu_acts -%}
        {%- else -%}{%- assign arr = fri_arr -%}{%- assign acts = fri_acts -%}
      {%- endcase -%}
      {%- assign is_today = false -%}
      {%- if hl and is_weekend == false and d_no == dow -%}{%- assign is_today = true -%}{%- endif -%}
      {%- assign bold = "" -%}
      {%- if is_today -%}{%- assign bold = " text--bold" -%}{%- endif -%}
      <tr{% if is_today %} class="tt-today-row"{% endif %}>
        <td class="text--center py--1 px--1">
          {%- if is_today -%}
            <span class="label label--inverted lg:label--large block{{ bold }}">{{ day_short[d_i] }}</span>
            <span class="label label--small text--gray-30 block{{ bold }}">{{ today_str }}</span>
          {%- else -%}
            <span class="title title--small lg:title--base block">{{ day_short[d_i] }}</span>
            <span class="label label--small text--gray-30 block">&nbsp;</span>
          {%- endif -%}
        </td>
        {%- for i in (0..last_i) -%}
          {%- assign raw = arr[i] | default: "" | strip -%}
          {%- if raw == "-" or raw == "—" or raw == "–" -%}{%- assign raw = "" -%}{%- endif -%}
          {%- assign subj = raw | split: "|" | first | default: "" | strip -%}
          {%- assign room = "" -%}
          {%- if raw contains "|" -%}{%- assign room = raw | split: "|" | last | strip -%}{%- endif -%}
          {%- assign cls = "text--center py--1 px--1" -%}
          {%- assign ink = "text--gray-30" | append: bold -%}
          {%- assign ink_main = bold -%}
          {%- assign ink_dim = "text--gray-55" | append: bold -%}
          {%- if is_today and i == now_i -%}
            {%- assign cls = cls | append: " bg--black" -%}
            {%- assign ink = "text--white" -%}
            {%- assign ink_main = "text--white" -%}
            {%- assign ink_dim = "text--white" -%}
          {%- endif -%}
          <td class="{{ cls }}">
            {%- if subj == "" -%}
              <span class="label label--small {{ ink_dim }} block">—</span>
            {%- else -%}
              {%- assign subj_n = subj | split: "//" | size -%}
              <span class="label lg:label--large block {{ ink_main }}" data-clamp="{{ subj_n }}">{{ subj | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
            {%- endif -%}
            {%- if show_room -%}
              {%- assign room_n = room | split: "//" | size -%}
              {%- if room_n < 1 -%}{%- assign room_n = 1 -%}{%- endif -%}
              <span class="label label--small {{ ink }} hidden lg:block" data-clamp="{{ room_n }}">{%- if room != "" -%}{{ room | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}{%- else -%}&nbsp;{%- endif -%}</span>
            {%- endif -%}
          </td>
        {%- endfor -%}
        {%- if has_acts -%}
          <td class="border--v-black text--center py--1 px--1">
            {%- assign ents = acts | split: "~" -%}
            {%- if ents.size == 0 -%}
              <span class="label label--small text--gray-55 block">—</span>
            {%- endif -%}
            {%- for e in ents -%}
              {%- assign ep = e | split: "|" -%}
              {%- assign e_time = ep[0] | default: "" | strip -%}
              {%- assign e_name = ep[1] | default: "" | strip -%}
              {%- if e_name == "" -%}{%- assign e_name = e_time -%}{%- assign e_time = "" -%}{%- endif -%}
              {%- assign e_n = e_name | split: "//" | size -%}
              <span class="label label--small lg:label--base block{{ bold }}" data-clamp="{{ e_n }}">{{ e_name | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
              {%- if e_time != "" -%}
                <span class="label label--small text--gray-30 tt-nw block{{ bold }}">{{ e_time }}</span>
              {%- endif -%}
            {%- endfor -%}
          </td>
        {%- endif -%}
      </tr>
    {%- endfor -%}
    </tbody>
  </table>

{%- else -%}

  {%- comment -%} --- days across the top, time down the side (default) --- {%- endcomment -%}
  <table class="table table--base lg:table--large tt-grid tt-week w--full h--[{{ tt_fill }}cqh]" data-table-limit="true">
    <thead>
      <tr>
        <th class="text--center py--1 px--1"><span class="title title--small lg:title--base block">#</span></th>
        <th class="text--center py--1 px--1"><span class="title title--small lg:title--base block">Time</span></th>
        {%- for dk in day_keys -%}
          {%- assign d_no = forloop.index -%}
          {%- assign is_today = false -%}
          {%- if hl and is_weekend == false and d_no == dow -%}{%- assign is_today = true -%}{%- endif -%}
          {%- assign bold = "" -%}
          {%- if is_today -%}{%- assign bold = " text--bold" -%}{%- endif -%}
          <th class="text--center py--1 px--1{% if is_today %} tt-today{% endif %}">
            {%- if is_today -%}
              <span class="label label--inverted lg:label--large block{{ bold }}">{{ day_short[forloop.index0] }} · {{ today_str }}</span>
            {%- else -%}
              <span class="title title--small lg:title--base block">{{ day_short[forloop.index0] }}</span>
            {%- endif -%}
          </th>
        {%- endfor -%}
      </tr>
    </thead>
    <tbody>
    {%- for i in (0..last_i) -%}
      {%- assign lesson_no = i | plus: 1 -%}
      {%- assign t = times_arr[i] | default: "" | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" | replace: "-", "–" -%}
      <tr>
        {%- if i == now_i -%}
          <td class="text--center py--1 px--1"><span class="label label--inverted lg:label--large block">{{ lesson_no }}</span></td>
          <td class="text--center py--1 px--1"><span class="label label--small lg:label--base text--bold tt-nw block">{{ t }}</span></td>
        {%- else -%}
          <td class="text--center py--1 px--1"><span class="label label--small lg:label--base block">{{ lesson_no }}</span></td>
          <td class="text--center py--1 px--1"><span class="label label--small lg:label--base tt-nw block">{{ t }}</span></td>
        {%- endif -%}
        {%- for dk in day_keys -%}
          {%- assign d_no = forloop.index -%}
          {%- case dk -%}
            {%- when "mon" -%}{%- assign arr = mon_arr -%}
            {%- when "tue" -%}{%- assign arr = tue_arr -%}
            {%- when "wed" -%}{%- assign arr = wed_arr -%}
            {%- when "thu" -%}{%- assign arr = thu_arr -%}
            {%- else -%}{%- assign arr = fri_arr -%}
          {%- endcase -%}
          {%- assign raw = arr[i] | default: "" | strip -%}
          {%- if raw == "-" or raw == "—" or raw == "–" -%}{%- assign raw = "" -%}{%- endif -%}
          {%- assign subj = raw | split: "|" | first | default: "" | strip -%}
          {%- assign room = "" -%}
          {%- if raw contains "|" -%}{%- assign room = raw | split: "|" | last | strip -%}{%- endif -%}
          {%- assign cls = "text--center py--1 px--1" -%}
          {%- assign ink = "text--gray-30" -%}
          {%- assign ink_main = "" -%}
          {%- assign ink_dim = "text--gray-55" -%}
          {%- if hl and is_weekend == false and d_no == dow -%}
            {%- assign cls = cls | append: " tt-today" -%}
            {%- assign ink = ink | append: " text--bold" -%}
            {%- assign ink_main = ink_main | append: " text--bold" -%}
            {%- assign ink_dim = ink_dim | append: " text--bold" -%}
            {%- if i == now_i -%}
              {%- assign cls = cls | append: " bg--black" -%}
              {%- assign ink = "text--white" -%}
              {%- assign ink_main = "text--white" -%}
              {%- assign ink_dim = "text--white" -%}
            {%- endif -%}
          {%- endif -%}
          <td class="{{ cls }}">
            {%- if subj == "" -%}
              <span class="label label--small {{ ink_dim }} block">—</span>
            {%- else -%}
              {%- assign subj_n = subj | split: "//" | size -%}
              <span class="label lg:label--large block {{ ink_main }}" data-clamp="{{ subj_n }}">{{ subj | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
            {%- endif -%}
            {%- if show_room -%}
              {%- assign room_n = room | split: "//" | size -%}
              {%- if room_n < 1 -%}{%- assign room_n = 1 -%}{%- endif -%}
              <span class="label label--small {{ ink }} hidden lg:block" data-clamp="{{ room_n }}">{%- if room != "" -%}{{ room | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}{%- else -%}&nbsp;{%- endif -%}</span>
            {%- endif -%}
          </td>
        {%- endfor -%}
      </tr>
      {%- for b in breaks_arr -%}
        {%- assign bs = b | strip -%}
        {%- if bs contains ":" -%}
          {%- assign b_no = bs | split: ":" | first | strip | plus: 0 -%}
          {%- assign b_name = bs | split: ":" | last | strip -%}
          {%- if b_no == lesson_no and i < last_i -%}
            <tr class="tt-break">
              <td colspan="7" class="text--center py--0 px--1"><span class="label label--small lg:label--base text--gray-25 block">{{ b_name | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span></td>
            </tr>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- if has_acts -%}
      <tr class="tt-act-row">
        <td colspan="2" class="text--center py--1 px--1"><span class="label label--small lg:label--base block">After school</span></td>
        {%- for dk in day_keys -%}
          {%- assign d_no = forloop.index -%}
          {%- case dk -%}
            {%- when "mon" -%}{%- assign acts = mon_acts -%}
            {%- when "tue" -%}{%- assign acts = tue_acts -%}
            {%- when "wed" -%}{%- assign acts = wed_acts -%}
            {%- when "thu" -%}{%- assign acts = thu_acts -%}
            {%- else -%}{%- assign acts = fri_acts -%}
          {%- endcase -%}
          {%- assign cls = "text--center py--1 px--1" -%}
          {%- assign bold = "" -%}
          {%- if hl and is_weekend == false and d_no == dow -%}
            {%- assign cls = cls | append: " tt-today" -%}
            {%- assign bold = " text--bold" -%}
          {%- endif -%}
          <td class="{{ cls }}">
            {%- assign ents = acts | split: "~" -%}
            {%- if ents.size == 0 -%}
              <span class="label label--small text--gray-55 block">—</span>
            {%- endif -%}
            {%- for e in ents -%}
              {%- assign ep = e | split: "|" -%}
              {%- assign e_time = ep[0] | default: "" | strip -%}
              {%- assign e_name = ep[1] | default: "" | strip -%}
              {%- if e_name == "" -%}{%- assign e_name = e_time -%}{%- assign e_time = "" -%}{%- endif -%}
              {%- assign e_n = e_name | split: "//" | size -%}
              <span class="label label--small lg:label--base block{{ bold }}" data-clamp="{{ e_n }}">{{ e_name | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
              {%- if e_time != "" -%}
                <span class="label label--small text--gray-30 tt-nw block{{ bold }}">{{ e_time }}</span>
              {%- endif -%}
            {%- endfor -%}
          </td>
        {%- endfor -%}
      </tr>
    {%- endif -%}
    </tbody>
  </table>

{%- endif -%}
</div>

<div class="title_bar">
  <img class="image image-dither" src="{{ tt_icon }}" />
  <span class="title">Timetable</span>
  <span class="instance">{{ class_name }}{% if school_year != "" %} · {{ school_year }}{% endif %}</span>
</div>
