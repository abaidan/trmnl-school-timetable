{%- comment -%} ===== School timetable: shared data prep ===== {%- endcomment -%}
{%- capture nl %}
{% endcapture -%}
{%- assign cf = trmnl.plugin_settings.custom_fields_values -%}
{%- assign class_name = cf.class_name | default: "" | strip -%}
{%- assign school_year = cf.school_year | default: "" | strip -%}

{%- assign hl = true -%}
{%- if cf.highlight_today == false or cf.highlight_today == "false" -%}{%- assign hl = false -%}{%- endif -%}
{%- assign show_room = true -%}
{%- if cf.show_room == false or cf.show_room == "false" -%}{%- assign show_room = false -%}{%- endif -%}

{%- comment -%} grid orientation: days across the top (default), or days down the side and time across the top {%- endcomment -%}
{%- assign orient = cf.orientation | default: "" | downcase -%}
{%- assign days_as_rows = false -%}
{%- if orient contains "row" -%}{%- assign days_as_rows = true -%}{%- endif -%}

{%- assign times_arr = cf.lesson_times | default: "" | split: nl -%}
{%- assign breaks_arr = cf.breaks | default: "" | split: nl -%}
{%- assign mon_arr = cf.mon | default: "" | split: nl -%}
{%- assign tue_arr = cf.tue | default: "" | split: nl -%}
{%- assign wed_arr = cf.wed | default: "" | split: nl -%}
{%- assign thu_arr = cf.thu | default: "" | split: nl -%}
{%- assign fri_arr = cf.fri | default: "" | split: nl -%}

{%- comment -%} user's local time {%- endcomment -%}
{%- assign now_utc = trmnl.system.timestamp_utc | default: "now" | date: "%s" | plus: 0 -%}
{%- assign offset = trmnl.user.utc_offset | default: 0 | plus: 0 -%}
{%- assign now_local = now_utc | plus: offset -%}
{%- assign dow = now_local | date: "%u" | plus: 0 -%}
{%- assign now_h = now_local | date: "%H" | plus: 0 -%}
{%- assign now_m = now_local | date: "%M" | plus: 0 -%}
{%- assign now_min = now_h | times: 60 | plus: now_m -%}
{%- assign today_str = now_local | date: "%d.%m" -%}

{%- assign is_weekend = false -%}
{%- if dow > 5 -%}{%- assign is_weekend = true -%}{%- endif -%}
{%- assign show_dow = dow -%}
{%- if is_weekend -%}{%- assign show_dow = 1 -%}{%- endif -%}
{%- assign next_dow = dow | plus: 1 -%}
{%- if next_dow > 5 -%}{%- assign next_dow = 1 -%}{%- endif -%}

{%- comment -%} title-bar icon, inlined by tools/make_icon.py — do not edit by hand {%- endcomment -%}
{%- assign tt_icon = "data:image/svg+xml;base64," -%}

{%- assign day_keys = "mon,tue,wed,thu,fri" | split: "," -%}
{%- assign day_short = "Mon,Tue,Wed,Thu,Fri" | split: "," -%}
{%- assign day_long = "Monday,Tuesday,Wednesday,Thursday,Friday" | split: "," -%}

{%- comment -%}
  after-school activities: one per line, "Mon | 15:00-16:30 | Football".
  Stored per day as "time|name~time|name" ("~" separates entries).
{%- endcomment -%}
{%- assign acts_arr = cf.activities | default: "" | split: nl -%}
{%- assign mon_acts = "" -%}
{%- assign tue_acts = "" -%}
{%- assign wed_acts = "" -%}
{%- assign thu_acts = "" -%}
{%- assign fri_acts = "" -%}
{%- assign has_acts = false -%}
{%- for a in acts_arr -%}
  {%- assign line = a | strip -%}
  {%- if line == "" -%}{%- continue -%}{%- endif -%}
  {%- assign parts = line | split: "|" -%}
  {%- assign a_day = parts[0] | default: "" | strip | downcase | slice: 0, 3 -%}
  {%- assign a_time = "" -%}
  {%- assign a_name = "" -%}
  {%- if parts.size > 2 -%}
    {%- assign a_time = parts[1] | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" | replace: "-", "–" -%}
    {%- assign a_name = parts[2] | strip -%}
  {%- elsif parts.size == 2 -%}
    {%- assign a_name = parts[1] | strip -%}
  {%- endif -%}
  {%- if a_name == "" -%}{%- continue -%}{%- endif -%}
  {%- assign entry = a_time | append: "|" | append: a_name -%}
  {%- case a_day -%}
    {%- when "mon" -%}
      {%- if mon_acts != "" -%}{%- assign mon_acts = mon_acts | append: "~" -%}{%- endif -%}
      {%- assign mon_acts = mon_acts | append: entry -%}
    {%- when "tue" -%}
      {%- if tue_acts != "" -%}{%- assign tue_acts = tue_acts | append: "~" -%}{%- endif -%}
      {%- assign tue_acts = tue_acts | append: entry -%}
    {%- when "wed" -%}
      {%- if wed_acts != "" -%}{%- assign wed_acts = wed_acts | append: "~" -%}{%- endif -%}
      {%- assign wed_acts = wed_acts | append: entry -%}
    {%- when "thu" -%}
      {%- if thu_acts != "" -%}{%- assign thu_acts = thu_acts | append: "~" -%}{%- endif -%}
      {%- assign thu_acts = thu_acts | append: entry -%}
    {%- when "fri" -%}
      {%- if fri_acts != "" -%}{%- assign fri_acts = fri_acts | append: "~" -%}{%- endif -%}
      {%- assign fri_acts = fri_acts | append: entry -%}
    {%- else -%}
      {%- continue -%}
  {%- endcase -%}
  {%- assign has_acts = true -%}
{%- endfor -%}

{%- comment -%} how many lesson rows are actually filled in (max 8) {%- endcomment -%}
{%- assign n_rows = 0 -%}
{%- for i in (0..7) -%}
  {%- assign any = "" -%}
  {%- assign any = any | append: mon_arr[i] | append: tue_arr[i] | append: wed_arr[i] | append: thu_arr[i] | append: fri_arr[i] -%}
  {%- assign any = any | replace: "-", "" | strip -%}
  {%- if any != "" -%}{%- assign n_rows = i | plus: 1 -%}{%- endif -%}
{%- endfor -%}
{%- if n_rows == 0 -%}{%- assign n_rows = times_arr.size -%}{%- endif -%}
{%- if n_rows > 8 -%}{%- assign n_rows = 8 -%}{%- endif -%}
{%- assign last_i = n_rows | minus: 1 -%}

{%- comment -%} how many break rows actually render (they sit between lessons) {%- endcomment -%}
{%- assign n_breaks = 0 -%}
{%- for b in breaks_arr -%}
  {%- assign bs = b | strip -%}
  {%- if bs contains ":" -%}
    {%- assign b_no = bs | split: ":" | first | strip | plus: 0 -%}
    {%- if b_no >= 1 and b_no < n_rows -%}{%- assign n_breaks = n_breaks | plus: 1 -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} index of the lesson happening right now (0-based), or -1 {%- endcomment -%}
{%- assign now_i = -1 -%}
{%- if hl and is_weekend == false -%}
  {%- for i in (0..last_i) -%}
    {%- assign t = times_arr[i] | default: "" | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" -%}
    {%- assign t_start = t | split: "-" | first | default: "" -%}
    {%- assign t_end = t | split: "-" | last | default: "" -%}
    {%- if t_start contains ":" and t_end contains ":" -%}
      {%- assign hh = t_start | split: ":" | first | plus: 0 -%}
      {%- assign mm = t_start | split: ":" | last | plus: 0 -%}
      {%- assign s_min = hh | times: 60 | plus: mm -%}
      {%- assign hh = t_end | split: ":" | first | plus: 0 -%}
      {%- assign mm = t_end | split: ":" | last | plus: 0 -%}
      {%- assign e_min = hh | times: 60 | plus: mm -%}
      {%- if now_min >= s_min and now_min < e_min -%}{%- assign now_i = i -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
<style>
  /* equal-sized cells: fixed layout + explicit column widths, centred content */
  .tt-grid { table-layout: fixed; width: 100%; }
  .tt-grid th, .tt-grid td {
    text-align: center !important;
    vertical-align: middle !important;
    padding: 5px 6px !important;
    overflow: hidden;
  }
  .tt-grid th > span, .tt-grid td > span { display: block; text-align: center; }
  .tt-today .label, .tt-today .title { font-weight: 700; }
  .tt-today { box-shadow: inset 2px 0 0 #000, inset -2px 0 0 #000; }
  .tt-today-row { box-shadow: inset 0 2px 0 #000, inset 0 -2px 0 #000; }
  .tt-today-row .label, .tt-today-row .title { font-weight: 700; }
  .tt-now { background: #000; }
  .tt-now .label, .tt-now .title { color: #fff; }
  .tt-now .tt-room, .tt-now .tt-act-time { color: #fff; opacity: .8; }
  .tt-break td { padding-top: 0 !important; padding-bottom: 0 !important; }
  .tt-break .label { opacity: .7; }
  .tt-room { opacity: .65; }
  /* on small screens (OG) the room line in the week grid does not fit */
  .screen:not(.screen--lg) .tt-week .tt-room { display: none !important; }
  .tt-empty { opacity: .35; }
  .tt-act-time { opacity: .65; }
  .tt-act-sep { border-top: 2px solid #000; }
</style>

{%- comment -%} ===== FULL: the whole week ===== {%- endcomment -%}

{%- comment -%}
  Row heights are computed rather than left to the content, otherwise the grid
  sits in a thin band with dead space above and below it. Break rows stay
  compact and get a smaller share; everything else splits what is left.
  vh is safe here because the full view always owns the whole screen.
{%- endcomment -%}
{%- assign tt_avail = 84.0 -%}
{%- assign tt_break_h = 3.5 -%}
{%- if days_as_rows -%}
  {%- assign tt_tall = 6 -%}
  {%- assign tt_breaks = 0 -%}
{%- else -%}
  {%- assign tt_tall = n_rows | plus: 1 -%}
  {%- if has_acts -%}{%- assign tt_tall = tt_tall | plus: 1 -%}{%- endif -%}
  {%- assign tt_breaks = n_breaks -%}
{%- endif -%}
{%- assign tt_used = tt_breaks | times: tt_break_h -%}
{%- comment -%} capped so a nearly empty timetable doesn't get absurd rows {%- endcomment -%}
{%- assign tt_row_h = tt_avail | minus: tt_used | divided_by: tt_tall | at_most: 20 | round: 2 -%}
<style>
  .tt-week { height: 100%; }
  .tt-week tr { height: {{ tt_row_h }}vh; }
  .tt-week tr.tt-break { height: {{ tt_break_h }}vh; }
</style>

<div class="layout layout--col layout--stretch-x gap--small">
{%- if days_as_rows -%}

  {%- comment -%} --- time across the top, days down the side --- {%- endcomment -%}
  {%- assign n_cols = n_rows -%}
  {%- if has_acts -%}{%- assign n_cols = n_cols | plus: 1 -%}{%- endif -%}
  {%- assign colw = 87 | divided_by: n_cols -%}
  <table class="table table--base lg:table--large tt-grid tt-week" data-table-limit="true">
    <thead>
      <tr>
        <th style="width:13%"><span class="title title--small lg:title--base">Day</span></th>
        {%- for i in (0..last_i) -%}
          {%- assign lesson_no = forloop.index -%}
          {%- assign t = times_arr[i] | default: "" | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" | replace: "-", "–" -%}
          <th style="width:{{ colw }}%">
            <span class="title title--small lg:title--base">{{ lesson_no }}</span>
            <span class="label label--small tt-room" style="white-space:nowrap">{{ t }}</span>
          </th>
        {%- endfor -%}
        {%- if has_acts -%}
          <th class="tt-act-sep" style="width:{{ colw }}%">
            <span class="title title--small lg:title--base">After school</span>
            <span class="label label--small tt-room">&nbsp;</span>
          </th>
        {%- endif -%}
      </tr>
    </thead>
    <tbody>
    {%- for dk in day_keys -%}
      {%- assign d_no = forloop.index -%}
      {%- assign d_i = forloop.index0 -%}
      {%- case dk -%}
        {%- when "mon" -%}{%- assign arr = mon_arr -%}{%- assign acts = mon_acts -%}
        {%- when "tue" -%}{%- assign arr = tue_arr -%}{%- assign acts = tue_acts -%}
        {%- when "wed" -%}{%- assign arr = wed_arr -%}{%- assign acts = wed_acts -%}
        {%- when "thu" -%}{%- assign arr = thu_arr -%}{%- assign acts = thu_acts -%}
        {%- else -%}{%- assign arr = fri_arr -%}{%- assign acts = fri_acts -%}
      {%- endcase -%}
      {%- assign is_today = false -%}
      {%- if hl and is_weekend == false and d_no == dow -%}{%- assign is_today = true -%}{%- endif -%}
      <tr{% if is_today %} class="tt-today-row"{% endif %}>
        <td>
          {%- if is_today -%}
            <span class="label label--inverted lg:label--large">{{ day_short[d_i] }}</span>
            <span class="label label--small tt-room">{{ today_str }}</span>
          {%- else -%}
            <span class="title title--small lg:title--base">{{ day_short[d_i] }}</span>
            <span class="label label--small tt-room">&nbsp;</span>
          {%- endif -%}
        </td>
        {%- for i in (0..last_i) -%}
          {%- assign raw = arr[i] | default: "" | strip -%}
          {%- if raw == "-" or raw == "—" or raw == "–" -%}{%- assign raw = "" -%}{%- endif -%}
          {%- assign subj = raw | split: "|" | first | default: "" | strip -%}
          {%- assign room = "" -%}
          {%- if raw contains "|" -%}{%- assign room = raw | split: "|" | last | strip -%}{%- endif -%}
          {%- assign cls = "" -%}
          {%- if is_today and i == now_i -%}{%- assign cls = "tt-now" -%}{%- endif -%}
          <td{% if cls != "" %} class="{{ cls }}"{% endif %}>
            {%- if subj == "" -%}
              <span class="label label--small tt-empty">—</span>
            {%- else -%}
              {%- assign subj_n = subj | split: "//" | size -%}
              <span class="label lg:label--large" data-clamp="{{ subj_n }}">{{ subj | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
            {%- endif -%}
            {%- if show_room -%}
              {%- assign room_n = room | split: "//" | size -%}
              {%- if room_n < 1 -%}{%- assign room_n = 1 -%}{%- endif -%}
              <span class="label label--small tt-room" data-clamp="{{ room_n }}">{%- if room != "" -%}{{ room | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}{%- else -%}&nbsp;{%- endif -%}</span>
            {%- endif -%}
          </td>
        {%- endfor -%}
        {%- if has_acts -%}
          <td class="tt-act-sep">
            {%- assign ents = acts | split: "~" -%}
            {%- if ents.size == 0 -%}
              <span class="label label--small tt-empty">—</span>
            {%- endif -%}
            {%- for e in ents -%}
              {%- assign ep = e | split: "|" -%}
              {%- assign e_time = ep[0] | default: "" | strip -%}
              {%- assign e_name = ep[1] | default: "" | strip -%}
              {%- if e_name == "" -%}{%- assign e_name = e_time -%}{%- assign e_time = "" -%}{%- endif -%}
              {%- assign e_n = e_name | split: "//" | size -%}
              <span class="label label--small lg:label--base" data-clamp="{{ e_n }}">{{ e_name | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
              {%- if e_time != "" -%}
                <span class="label label--small tt-act-time" style="white-space:nowrap">{{ e_time }}</span>
              {%- endif -%}
            {%- endfor -%}
          </td>
        {%- endif -%}
      </tr>
    {%- endfor -%}
    </tbody>
  </table>

{%- else -%}

  {%- comment -%} --- days across the top, time down the side (default) --- {%- endcomment -%}
  <table class="table table--base lg:table--large tt-grid tt-week" data-table-limit="true">
    <thead>
      <tr>
        <th style="width:6%"><span class="title title--small lg:title--base">#</span></th>
        <th style="width:13%"><span class="title title--small lg:title--base">Time</span></th>
        {%- for dk in day_keys -%}
          {%- assign d_no = forloop.index -%}
          {%- assign is_today = false -%}
          {%- if hl and is_weekend == false and d_no == dow -%}{%- assign is_today = true -%}{%- endif -%}
          <th style="width:16%"{% if is_today %} class="tt-today"{% endif %}>
            {%- if is_today -%}
              <span class="label label--inverted lg:label--large">{{ day_short[forloop.index0] }} · {{ today_str }}</span>
            {%- else -%}
              <span class="title title--small lg:title--base">{{ day_short[forloop.index0] }}</span>
            {%- endif -%}
          </th>
        {%- endfor -%}
      </tr>
    </thead>
    <tbody>
    {%- for i in (0..last_i) -%}
      {%- assign lesson_no = i | plus: 1 -%}
      {%- assign t = times_arr[i] | default: "" | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" | replace: "-", "–" -%}
      <tr>
        <td><span class="label label--small lg:label--base">{{ lesson_no }}</span></td>
        <td><span class="label label--small lg:label--base" style="white-space:nowrap">{{ t }}</span></td>
        {%- for dk in day_keys -%}
          {%- assign d_no = forloop.index -%}
          {%- case dk -%}
            {%- when "mon" -%}{%- assign arr = mon_arr -%}
            {%- when "tue" -%}{%- assign arr = tue_arr -%}
            {%- when "wed" -%}{%- assign arr = wed_arr -%}
            {%- when "thu" -%}{%- assign arr = thu_arr -%}
            {%- else -%}{%- assign arr = fri_arr -%}
          {%- endcase -%}
          {%- assign raw = arr[i] | default: "" | strip -%}
          {%- if raw == "-" or raw == "—" or raw == "–" -%}{%- assign raw = "" -%}{%- endif -%}
          {%- assign subj = raw | split: "|" | first | default: "" | strip -%}
          {%- assign room = "" -%}
          {%- if raw contains "|" -%}{%- assign room = raw | split: "|" | last | strip -%}{%- endif -%}
          {%- assign cls = "" -%}
          {%- if hl and is_weekend == false and d_no == dow -%}
            {%- assign cls = "tt-today" -%}
            {%- if i == now_i -%}{%- assign cls = "tt-today tt-now" -%}{%- endif -%}
          {%- endif -%}
          <td{% if cls != "" %} class="{{ cls }}"{% endif %}>
            {%- if subj == "" -%}
              <span class="label label--small tt-empty">—</span>
            {%- else -%}
              {%- assign subj_n = subj | split: "//" | size -%}
              <span class="label lg:label--large" data-clamp="{{ subj_n }}">{{ subj | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
            {%- endif -%}
            {%- if show_room -%}
              {%- assign room_n = room | split: "//" | size -%}
              {%- if room_n < 1 -%}{%- assign room_n = 1 -%}{%- endif -%}
              <span class="label label--small tt-room" data-clamp="{{ room_n }}">{%- if room != "" -%}{{ room | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}{%- else -%}&nbsp;{%- endif -%}</span>
            {%- endif -%}
          </td>
        {%- endfor -%}
      </tr>
      {%- for b in breaks_arr -%}
        {%- assign bs = b | strip -%}
        {%- if bs contains ":" -%}
          {%- assign b_no = bs | split: ":" | first | strip | plus: 0 -%}
          {%- assign b_name = bs | split: ":" | last | strip -%}
          {%- if b_no == lesson_no and i < last_i -%}
            <tr class="tt-break">
              <td colspan="7"><span class="label label--small lg:label--base">{{ b_name | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span></td>
            </tr>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- if has_acts -%}
      <tr class="tt-act-sep">
        <td colspan="2"><span class="label label--small lg:label--base">After school</span></td>
        {%- for dk in day_keys -%}
          {%- assign d_no = forloop.index -%}
          {%- case dk -%}
            {%- when "mon" -%}{%- assign acts = mon_acts -%}
            {%- when "tue" -%}{%- assign acts = tue_acts -%}
            {%- when "wed" -%}{%- assign acts = wed_acts -%}
            {%- when "thu" -%}{%- assign acts = thu_acts -%}
            {%- else -%}{%- assign acts = fri_acts -%}
          {%- endcase -%}
          {%- assign cls = "" -%}
          {%- if hl and is_weekend == false and d_no == dow -%}{%- assign cls = "tt-today" -%}{%- endif -%}
          <td{% if cls != "" %} class="{{ cls }}"{% endif %}>
            {%- assign ents = acts | split: "~" -%}
            {%- if ents.size == 0 -%}
              <span class="label label--small tt-empty">—</span>
            {%- endif -%}
            {%- for e in ents -%}
              {%- assign ep = e | split: "|" -%}
              {%- assign e_time = ep[0] | default: "" | strip -%}
              {%- assign e_name = ep[1] | default: "" | strip -%}
              {%- if e_name == "" -%}{%- assign e_name = e_time -%}{%- assign e_time = "" -%}{%- endif -%}
              {%- assign e_n = e_name | split: "//" | size -%}
              <span class="label label--small lg:label--base" data-clamp="{{ e_n }}">{{ e_name | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
              {%- if e_time != "" -%}
                <span class="label label--small tt-act-time" style="white-space:nowrap">{{ e_time }}</span>
              {%- endif -%}
            {%- endfor -%}
          </td>
        {%- endfor -%}
      </tr>
    {%- endif -%}
    </tbody>
  </table>

{%- endif -%}
</div>

<div class="title_bar">
  <img class="image" src="{{ tt_icon }}" />
  <span class="title">Timetable</span>
  <span class="instance">{{ class_name }}{% if school_year != "" %} · {{ school_year }}{% endif %}</span>
</div>
