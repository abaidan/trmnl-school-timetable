{%- comment -%} ===== TODAY (Monday on weekends) ===== {%- endcomment -%}
{%- assign d_idx = show_dow | minus: 1 -%}
{%- case show_dow -%}
  {%- when 1 -%}{%- assign arr = mon_arr -%}{%- assign acts = mon_acts -%}
  {%- when 2 -%}{%- assign arr = tue_arr -%}{%- assign acts = tue_acts -%}
  {%- when 3 -%}{%- assign arr = wed_arr -%}{%- assign acts = wed_acts -%}
  {%- when 4 -%}{%- assign arr = thu_arr -%}{%- assign acts = thu_acts -%}
  {%- else -%}{%- assign arr = fri_arr -%}{%- assign acts = fri_acts -%}
{%- endcase -%}
{%- assign heading = day_long[d_idx] -%}
{%- if is_weekend == false -%}{%- assign heading = heading | append: " · " | append: today_str -%}{%- endif -%}

{%- comment -%} are there any lessons at all {%- endcomment -%}
{%- assign has_any = false -%}
{%- for i in (0..last_i) -%}
  {%- assign raw = arr[i] | default: "" | strip | replace: "-", "" | replace: "—", "" | replace: "–", "" -%}
  {%- if raw != "" -%}{%- assign has_any = true -%}{%- endif -%}
{%- endfor -%}

{%- comment -%} column widths: keep every cell the same size {%- endcomment -%}
{%- assign w_no = "12%" -%}
{%- assign w_time = "26%" -%}
{%- assign w_subj = "36%" -%}
{%- if tt_show_room == false -%}
  {%- assign w_time = "30%" -%}
  {%- assign w_subj = "58%" -%}
{%- endif -%}
<style>
  {%- comment -%} table-layout is fixed, so the first row sets every column {%- endcomment -%}
  .tt-list tr:first-child td:nth-child(1) { width: {{ w_no }}; }
  .tt-list tr:first-child td:nth-child(2) { width: {{ w_time }}; }
  .tt-list tr:first-child td:nth-child(3) { width: {{ w_subj }}; }
  .tt-list tr:first-child td:nth-child(4) { width: 26%; }
  .tt-acts tr:first-child td:nth-child(1) { width: 38%; }
</style>

<div class="layout layout--col layout--stretch-x gap--small">
  <div class="flex flex--row flex--between flex--center-y">
    <span class="title title--small lg:title--base">{{ heading }}</span>
    {%- if is_weekend -%}<span class="label label--small label--outline">day off</span>{%- endif -%}
  </div>
  {%- if has_any == false -%}
    <div class="flex flex--center stretch">
      <span class="label label--large">No lessons</span>
    </div>
  {%- else -%}
  <table class="table {{ tt_size }} tt-grid tt-list w--full text--center" data-table-limit="true">
    <tbody>
    {%- for i in (0..last_i) -%}
      {%- assign lesson_no = i | plus: 1 -%}
      {%- assign raw = arr[i] | default: "" | strip -%}
      {%- if raw == "-" or raw == "—" or raw == "–" -%}{%- assign raw = "" -%}{%- endif -%}
      {%- assign subj = raw | split: "|" | first | default: "" | strip -%}
      {%- assign room = "" -%}
      {%- if raw contains "|" -%}{%- assign room = raw | split: "|" | last | strip -%}{%- endif -%}
      {%- assign t = times_arr[i] | default: "" | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" | replace: "-", "–" -%}
      {%- if tt_skip_empty and subj == "" -%}{%- continue -%}{%- endif -%}
      {%- assign ink = "text--gray-30" -%}
      {%- assign ink_main = "" -%}
      {%- assign ink_dim = "text--gray-55" -%}
      {%- assign rcls = "" -%}
      {%- if i == now_i and is_weekend == false -%}
        {%- assign rcls = "tt-now bg--black" -%}
        {%- assign ink = "text--white" -%}
        {%- assign ink_main = "text--white" -%}
        {%- assign ink_dim = "text--white" -%}
      {%- endif -%}
      <tr{% if rcls != "" %} class="{{ rcls }}"{% endif %}>
        <td class="py--1 px--1"><span class="label label--small block {{ ink_main }}">{{ lesson_no }}</span></td>
        <td class="py--1 px--1"><span class="label label--small tt-nw block {{ ink_main }}">{{ t }}</span></td>
        <td class="py--1 px--1">
          {%- if subj == "" -%}
            <span class="label label--small {{ ink_dim }} block">—</span>
          {%- else -%}
            {%- assign subj_n = subj | split: "//" | size -%}
            <span class="label {{ tt_subj_size }} block {{ ink_main }}" data-clamp="{{ subj_n }}">{{ subj | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
          {%- endif -%}
        </td>
        {%- if tt_show_room -%}
        {%- assign room_n = room | split: "//" | size -%}
        {%- if room_n < 1 -%}{%- assign room_n = 1 -%}{%- endif -%}
        <td class="py--1 px--1"><span class="label label--small {{ ink }} block" data-clamp="{{ room_n }}">{{ room | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span></td>
        {%- endif -%}
      </tr>
    {%- endfor -%}
    </tbody>
  </table>
  {%- endif -%}

  {%- if acts != "" -%}
    <span class="title title--small tt-act-sep block">After school</span>
    <table class="table {{ tt_size }} tt-grid tt-acts w--full text--center" data-table-limit="true">
      <tbody>
        {%- assign ents = acts | split: "~" -%}
        {%- for e in ents -%}
          {%- assign ep = e | split: "|" -%}
          {%- assign e_time = ep[0] | default: "" | strip -%}
          {%- assign e_name = ep[1] | default: "" | strip -%}
          {%- if e_name == "" -%}{%- assign e_name = e_time -%}{%- assign e_time = "" -%}{%- endif -%}
          <tr>
            <td class="py--1 px--1"><span class="label label--small text--gray-30 tt-nw block">{{ e_time }}</span></td>
            {%- assign e_n = e_name | split: "//" | size -%}
            <td class="py--1 px--1"><span class="label {{ tt_subj_size }} block" data-clamp="{{ e_n }}">{{ e_name | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span></td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  {%- endif -%}
</div>

<div class="title_bar">
  <img class="image" src="{{ tt_icon }}" />
  <span class="title">Timetable</span>
  <span class="instance">{{ class_name }}{% if school_year != "" %} · {{ school_year }}{% endif %}</span>
</div>
