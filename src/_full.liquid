{%- comment -%} ===== FULL: the whole week ===== {%- endcomment -%}

{%- comment -%}
  Fill the screen: stretch the grid instead of letting the rows hug their
  content, which left it sitting in a band with dead space above and below.

  tt_fill is the one knob. It is a percentage of .layout, which the framework
  sizes to screen - gaps - title bar; 100 overflowed on a real device, most
  likely because that rule depends on :has() and the renderer falls back to a
  height that still includes the title bar. Under 100 covers the difference.

  Do not swap this for vh: that measures the whole viewport, title bar and
  gaps included, so it overshoots badly and data-table-limit responds by
  silently dropping rows.
{%- endcomment -%}
{%- assign tt_fill = 88 -%}
{%- if days_as_rows -%}
  {%- assign n_cols = n_rows -%}
  {%- if has_acts -%}{%- assign n_cols = n_cols | plus: 1 -%}{%- endif -%}
  {%- assign colw = 87 | divided_by: n_cols -%}
{%- endif -%}
<style>
  .tt-week { height: {{ tt_fill }}%; }
  {%- comment -%} table-layout is fixed, so the header row sets every column {%- endcomment -%}
  {%- if days_as_rows -%}
  .tt-week thead th:first-child { width: 13%; }
  .tt-week thead th:not(:first-child) { width: {{ colw }}%; }
  {%- else -%}
  .tt-week thead th:nth-child(1) { width: 6%; }
  .tt-week thead th:nth-child(2) { width: 13%; }
  .tt-week thead th:nth-child(n+3) { width: 16%; }
  {%- endif -%}
</style>

<div class="layout layout--col layout--stretch-x gap--small">
{%- if days_as_rows -%}

  {%- comment -%} --- time across the top, days down the side --- {%- endcomment -%}
  <table class="table table--base lg:table--large tt-grid tt-week" data-table-limit="true">
    <thead>
      <tr>
        <th><span class="title title--small lg:title--base">Day</span></th>
        {%- for i in (0..last_i) -%}
          {%- assign lesson_no = forloop.index -%}
          {%- assign t = times_arr[i] | default: "" | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" | replace: "-", "–" -%}
          <th>
            {%- if i == now_i -%}
              <span class="label label--inverted lg:label--large">{{ lesson_no }}</span>
              <span class="label label--small tt-now-time tt-nw">{{ t }}</span>
            {%- else -%}
              <span class="title title--small lg:title--base">{{ lesson_no }}</span>
              <span class="label label--small tt-room text--gray-30 tt-nw">{{ t }}</span>
            {%- endif -%}
          </th>
        {%- endfor -%}
        {%- if has_acts -%}
          <th class="tt-act-col">
            <span class="title title--small lg:title--base">After school</span>
            <span class="label label--small tt-room text--gray-30">&nbsp;</span>
          </th>
        {%- endif -%}
      </tr>
    </thead>
    <tbody>
    {%- for dk in day_keys -%}
      {%- assign d_no = forloop.index -%}
      {%- assign d_i = forloop.index0 -%}
      {%- case dk -%}
        {%- when "mon" -%}{%- assign arr = mon_arr -%}{%- assign acts = mon_acts -%}
        {%- when "tue" -%}{%- assign arr = tue_arr -%}{%- assign acts = tue_acts -%}
        {%- when "wed" -%}{%- assign arr = wed_arr -%}{%- assign acts = wed_acts -%}
        {%- when "thu" -%}{%- assign arr = thu_arr -%}{%- assign acts = thu_acts -%}
        {%- else -%}{%- assign arr = fri_arr -%}{%- assign acts = fri_acts -%}
      {%- endcase -%}
      {%- assign is_today = false -%}
      {%- if hl and is_weekend == false and d_no == dow -%}{%- assign is_today = true -%}{%- endif -%}
      <tr{% if is_today %} class="tt-today-row"{% endif %}>
        <td>
          {%- if is_today -%}
            <span class="label label--inverted lg:label--large">{{ day_short[d_i] }}</span>
            <span class="label label--small tt-room text--gray-30">{{ today_str }}</span>
          {%- else -%}
            <span class="title title--small lg:title--base">{{ day_short[d_i] }}</span>
            <span class="label label--small tt-room text--gray-30">&nbsp;</span>
          {%- endif -%}
        </td>
        {%- for i in (0..last_i) -%}
          {%- assign raw = arr[i] | default: "" | strip -%}
          {%- if raw == "-" or raw == "—" or raw == "–" -%}{%- assign raw = "" -%}{%- endif -%}
          {%- assign subj = raw | split: "|" | first | default: "" | strip -%}
          {%- assign room = "" -%}
          {%- if raw contains "|" -%}{%- assign room = raw | split: "|" | last | strip -%}{%- endif -%}
          {%- assign cls = "" -%}
          {%- if is_today and i == now_i -%}{%- assign cls = "tt-now" -%}{%- endif -%}
          <td{% if cls != "" %} class="{{ cls }}"{% endif %}>
            {%- if subj == "" -%}
              <span class="label label--small tt-empty text--gray-55">—</span>
            {%- else -%}
              {%- assign subj_n = subj | split: "//" | size -%}
              <span class="label lg:label--large" data-clamp="{{ subj_n }}">{{ subj | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
            {%- endif -%}
            {%- if show_room -%}
              {%- assign room_n = room | split: "//" | size -%}
              {%- if room_n < 1 -%}{%- assign room_n = 1 -%}{%- endif -%}
              <span class="label label--small tt-room text--gray-30" data-clamp="{{ room_n }}">{%- if room != "" -%}{{ room | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}{%- else -%}&nbsp;{%- endif -%}</span>
            {%- endif -%}
          </td>
        {%- endfor -%}
        {%- if has_acts -%}
          <td class="tt-act-col">
            {%- assign ents = acts | split: "~" -%}
            {%- if ents.size == 0 -%}
              <span class="label label--small tt-empty text--gray-55">—</span>
            {%- endif -%}
            {%- for e in ents -%}
              {%- assign ep = e | split: "|" -%}
              {%- assign e_time = ep[0] | default: "" | strip -%}
              {%- assign e_name = ep[1] | default: "" | strip -%}
              {%- if e_name == "" -%}{%- assign e_name = e_time -%}{%- assign e_time = "" -%}{%- endif -%}
              {%- assign e_n = e_name | split: "//" | size -%}
              <span class="label label--small lg:label--base" data-clamp="{{ e_n }}">{{ e_name | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
              {%- if e_time != "" -%}
                <span class="label label--small tt-act-time text--gray-30 tt-nw">{{ e_time }}</span>
              {%- endif -%}
            {%- endfor -%}
          </td>
        {%- endif -%}
      </tr>
    {%- endfor -%}
    </tbody>
  </table>

{%- else -%}

  {%- comment -%} --- days across the top, time down the side (default) --- {%- endcomment -%}
  <table class="table table--base lg:table--large tt-grid tt-week" data-table-limit="true">
    <thead>
      <tr>
        <th><span class="title title--small lg:title--base">#</span></th>
        <th><span class="title title--small lg:title--base">Time</span></th>
        {%- for dk in day_keys -%}
          {%- assign d_no = forloop.index -%}
          {%- assign is_today = false -%}
          {%- if hl and is_weekend == false and d_no == dow -%}{%- assign is_today = true -%}{%- endif -%}
          <th{% if is_today %} class="tt-today"{% endif %}>
            {%- if is_today -%}
              <span class="label label--inverted lg:label--large">{{ day_short[forloop.index0] }} · {{ today_str }}</span>
            {%- else -%}
              <span class="title title--small lg:title--base">{{ day_short[forloop.index0] }}</span>
            {%- endif -%}
          </th>
        {%- endfor -%}
      </tr>
    </thead>
    <tbody>
    {%- for i in (0..last_i) -%}
      {%- assign lesson_no = i | plus: 1 -%}
      {%- assign t = times_arr[i] | default: "" | strip | replace: "–", "-" | replace: "—", "-" | replace: " ", "" | replace: "-", "–" -%}
      <tr>
        {%- if i == now_i -%}
          <td><span class="label label--inverted lg:label--large">{{ lesson_no }}</span></td>
          <td><span class="label label--small lg:label--base tt-now-time tt-nw">{{ t }}</span></td>
        {%- else -%}
          <td><span class="label label--small lg:label--base">{{ lesson_no }}</span></td>
          <td><span class="label label--small lg:label--base tt-nw">{{ t }}</span></td>
        {%- endif -%}
        {%- for dk in day_keys -%}
          {%- assign d_no = forloop.index -%}
          {%- case dk -%}
            {%- when "mon" -%}{%- assign arr = mon_arr -%}
            {%- when "tue" -%}{%- assign arr = tue_arr -%}
            {%- when "wed" -%}{%- assign arr = wed_arr -%}
            {%- when "thu" -%}{%- assign arr = thu_arr -%}
            {%- else -%}{%- assign arr = fri_arr -%}
          {%- endcase -%}
          {%- assign raw = arr[i] | default: "" | strip -%}
          {%- if raw == "-" or raw == "—" or raw == "–" -%}{%- assign raw = "" -%}{%- endif -%}
          {%- assign subj = raw | split: "|" | first | default: "" | strip -%}
          {%- assign room = "" -%}
          {%- if raw contains "|" -%}{%- assign room = raw | split: "|" | last | strip -%}{%- endif -%}
          {%- assign cls = "" -%}
          {%- if hl and is_weekend == false and d_no == dow -%}
            {%- assign cls = "tt-today" -%}
            {%- if i == now_i -%}{%- assign cls = "tt-today tt-now" -%}{%- endif -%}
          {%- endif -%}
          <td{% if cls != "" %} class="{{ cls }}"{% endif %}>
            {%- if subj == "" -%}
              <span class="label label--small tt-empty text--gray-55">—</span>
            {%- else -%}
              {%- assign subj_n = subj | split: "//" | size -%}
              <span class="label lg:label--large" data-clamp="{{ subj_n }}">{{ subj | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
            {%- endif -%}
            {%- if show_room -%}
              {%- assign room_n = room | split: "//" | size -%}
              {%- if room_n < 1 -%}{%- assign room_n = 1 -%}{%- endif -%}
              <span class="label label--small tt-room text--gray-30" data-clamp="{{ room_n }}">{%- if room != "" -%}{{ room | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}{%- else -%}&nbsp;{%- endif -%}</span>
            {%- endif -%}
          </td>
        {%- endfor -%}
      </tr>
      {%- for b in breaks_arr -%}
        {%- assign bs = b | strip -%}
        {%- if bs contains ":" -%}
          {%- assign b_no = bs | split: ":" | first | strip | plus: 0 -%}
          {%- assign b_name = bs | split: ":" | last | strip -%}
          {%- if b_no == lesson_no and i < last_i -%}
            <tr class="tt-break">
              <td colspan="7"><span class="label label--small lg:label--base text--gray-25">{{ b_name | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span></td>
            </tr>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
    {%- if has_acts -%}
      <tr class="tt-act-row">
        <td colspan="2"><span class="label label--small lg:label--base">After school</span></td>
        {%- for dk in day_keys -%}
          {%- assign d_no = forloop.index -%}
          {%- case dk -%}
            {%- when "mon" -%}{%- assign acts = mon_acts -%}
            {%- when "tue" -%}{%- assign acts = tue_acts -%}
            {%- when "wed" -%}{%- assign acts = wed_acts -%}
            {%- when "thu" -%}{%- assign acts = thu_acts -%}
            {%- else -%}{%- assign acts = fri_acts -%}
          {%- endcase -%}
          {%- assign cls = "" -%}
          {%- if hl and is_weekend == false and d_no == dow -%}{%- assign cls = "tt-today" -%}{%- endif -%}
          <td{% if cls != "" %} class="{{ cls }}"{% endif %}>
            {%- assign ents = acts | split: "~" -%}
            {%- if ents.size == 0 -%}
              <span class="label label--small tt-empty text--gray-55">—</span>
            {%- endif -%}
            {%- for e in ents -%}
              {%- assign ep = e | split: "|" -%}
              {%- assign e_time = ep[0] | default: "" | strip -%}
              {%- assign e_name = ep[1] | default: "" | strip -%}
              {%- if e_name == "" -%}{%- assign e_name = e_time -%}{%- assign e_time = "" -%}{%- endif -%}
              {%- assign e_n = e_name | split: "//" | size -%}
              <span class="label label--small lg:label--base" data-clamp="{{ e_n }}">{{ e_name | replace: " //", "//" | replace: "// ", "//" | replace: "//", "<br>" }}</span>
              {%- if e_time != "" -%}
                <span class="label label--small tt-act-time text--gray-30 tt-nw">{{ e_time }}</span>
              {%- endif -%}
            {%- endfor -%}
          </td>
        {%- endfor -%}
      </tr>
    {%- endif -%}
    </tbody>
  </table>

{%- endif -%}
</div>

<div class="title_bar">
  <img class="image" src="{{ tt_icon }}" />
  <span class="title">Timetable</span>
  <span class="instance">{{ class_name }}{% if school_year != "" %} · {{ school_year }}{% endif %}</span>
</div>
